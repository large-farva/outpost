#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: nss-modules [--help]

Lists PKCS#11 modules configured in the NSS database used by CAC applications.

EOF
    exit 0
    ;;
  '') ;;
  *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh

NSSDB_DIR="${HOME}/.pki/nssdb"
NSSDB="sql:${NSSDB_DIR}"

hdr "NSS modules"
dim "Listing PKCS#11 modules in your NSS database."
printf '\n'

if [[ ! -f "${NSSDB_DIR}/cert9.db" ]]; then
  line "$(warn)" "NSS database not initialized: ${NSSDB_DIR}"
  dim "Run cac-nss-setup and try again."
  exit 1
fi

output="$(modutil -list -dbdir "$NSSDB" 2>&1)" || {
    printf '%s\n' "$output" >&2
    exit 1
}

if [[ -z "$output" ]]; then
  line "$(warn)" "No NSS modules found"
  exit 1
fi

box <<< "$output"
printf '\n'
line "$(ok)" "NSS modules listed"
exit 0
