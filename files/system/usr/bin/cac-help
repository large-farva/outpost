#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
    -h|--help) printf 'Usage: cac-help [--help] [--version]\nInteractive CAC tools; standalone commands also work without a terminal.\n'; exit 0 ;;
    --version) printf '2.0\n'; exit 0 ;;
esac
# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh
commands=(cac-check cac-recover cac-report cac-certs cac-log scan reader-list nss-modules trust-dod cac-pdf-setup)
if ! interactive || [[ ! -t 1 ]]; then
    printf '%s\n' "${commands[@]}"
    exit 0
fi
while true; do
    hdr 'CAC tools'
    choice=$(choose 'cac-check — Check CAC connection' 'cac-recover — Fix CAC connection' \
        'cac-report — Save diagnostic report' 'cac-certs — Card certificates' \
        'cac-log — Diagnostic logs' 'scan — Monitor card events' \
        'reader-list — Connected readers' 'nss-modules — Certificate providers' \
        'trust-dod — DoD trust anchors' 'cac-pdf-setup — Configure PDF signing' Back) || exit 0
    [[ "$choice" == Back ]] && exit 0
    run_cmd "${choice%% *}"
done
