#!/usr/bin/env bash
set -euo pipefail
# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh
case "${1:-}" in
    -h|--help)
        printf 'Usage: rebase [--help] [--version]\nSwitch between Outpost production and testing, with confirmation. Reboot manually afterward.\n'
        exit 0 ;;
    --version) printf '2.0\n'; exit 0 ;;
    '') ;;
    *) log_error "Unknown argument: $1"; exit 2 ;;
esac
interactive && [[ -t 1 ]] || { log_error 'Channel switching requires a terminal.'; exit 1; }
snapshot=$(deployment_snapshot) || exit 1
origin=$(jq -r '.[] | select(.booted) | .["container-image-reference"] // .origin // ""' <<< "$snapshot")
case "$origin" in
    ostree-image-signed:docker://*|ostree-unverified-registry:*|ostree-unverified-image:docker://*) ;;
    *) log_error 'The booted deployment is not a recognized Outpost container image.'; exit 1 ;;
esac
image=${origin#ostree-image-signed:docker://}
image=${image#ostree-unverified-registry:}
image=${image#ostree-unverified-image:docker://}
image=${image%%@*}
image=${image%%:*}
case "$image" in
    ghcr.io/large-farva/outpost) target=ghcr.io/large-farva/outpost-testing; channel=testing ;;
    ghcr.io/large-farva/outpost-testing) target=ghcr.io/large-farva/outpost; channel=production ;;
    *) log_error 'The booted image is not an Outpost production or testing image.'; exit 1 ;;
esac
hdr 'Switch Outpost channel'
printf 'Current: %s\nTarget:  %s:latest\n\n' "$image" "$target"
if [[ "$channel" == testing ]]; then
    log_warn 'Testing images may contain unfinished changes, including changes affecting CAC access.'
fi
printf 'This changes the OS used after the next reboot. Personal files and installed user applications remain shared.\n'
printf 'Keep a working deployment before switching: sudo ostree admin pin booted\n'
printf 'The target must pass the installed image signature policy. No automatic reboot.\n'
confirm "Switch to $channel?" || exit 0
current=$(deployment_snapshot) || exit 1
[[ "$current" == "$snapshot" ]] || { log_error 'Deployments changed. Run rebase again.'; exit 1; }
rpm-ostree rebase "ostree-image-signed:docker://$target:latest"
printf '\nRebase complete. Save your work, then reboot: systemctl reboot\n'
