#!/usr/bin/env bash
set -euo pipefail
case "${1:-}" in
    -h|--help)
        cat <<'HELP'
Usage: update [--help] [--version]
Update the OS, system and user Flatpaks, optional Homebrew, and Distrobox in sequence.
If containers exist, asks before updating all of them; skips them without a terminal.
Shows native progress and a final summary. Failures do not skip other stages.
Run as your desktop user; sudo invocation preserves the original user context.
Reboot manually if a pending OS deployment is reported.
HELP
        exit 0 ;;
    --version) printf '2.0\n'; exit 0 ;;
    '') ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac
# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh
trap 'printf "\nUpdate canceled; completed changes remain applied.\n" >&2; exit 130' INT
trap 'printf "\nUpdate terminated; completed changes remain applied.\n" >&2; exit 143' TERM

errors=0
results=()
run_stage() {
    local label="$1" start=$SECONDS rc=0
    shift
    section "$label"
    "$@" || rc=$?
    case "$rc" in
        130|143) printf '\nCanceled during %s; no further stages will run.\n' "$label" >&2; exit "$rc" ;;
        0) results+=("$label: success ($((SECONDS - start))s)") ;;
        *) results+=("$label: failed, exit $rc ($((SECONDS - start))s)"); ((++errors)) ;;
    esac
}
skip() { results+=("$1: skipped ($2)"); }

user_context

hdr 'Outpost update'
section 'Before update'
if have rpm-ostree && have jq; then
    deployment_status || log_warn 'Deployment status unavailable'
fi
if have rpm-ostree; then run_stage OS rpm-ostree upgrade
else results+=('OS: failed (rpm-ostree missing)'); ((++errors)); fi

if have flatpak; then
    run_stage 'System Flatpaks' flatpak --system update -y
    if [[ "$target_uid" != 0 ]]; then
        run_stage 'User Flatpaks' "${user_cmd[@]}" flatpak --user update -y
    else skip 'User Flatpaks' 'run as a desktop user'; fi
else
    skip 'System Flatpaks' 'flatpak not installed'
    skip 'User Flatpaks' 'flatpak not installed'
fi

if [[ "$target_uid" != 0 ]]; then
    # Homebrew may be added to PATH by the user's login profile.
    brew_path=$("${user_cmd[@]}" bash -lc 'command -v brew' 2>/dev/null) || brew_path=''
    if [[ -z "$brew_path" && -x /var/home/linuxbrew/.linuxbrew/bin/brew ]]; then
        brew_path=/var/home/linuxbrew/.linuxbrew/bin/brew
    fi
    if [[ -n "$brew_path" && -x "$brew_path" ]]; then
        run_stage Homebrew "${user_cmd[@]}" "$brew_path" upgrade
    else skip Homebrew 'not installed'; fi
else skip Homebrew 'run as a desktop user'; fi

if ! have distrobox; then
    skip Distrobox 'not installed'
elif [[ "$target_uid" == 0 ]]; then
    skip Distrobox 'run as a desktop user'
elif distrobox_list; then
    if ((distrobox_count == 0)); then
        skip Distrobox 'no containers'
    elif ! interactive || [[ ! -t 1 ]]; then
        skip Distrobox 'confirmation requires a terminal'
    else
        section 'Distrobox containers'
        printf '%s\n' "$distrobox_output"
        printf 'Updating all containers may start stopped containers and request package-manager confirmation.\n'
        rc=0
        confirm "Update all $distrobox_count Distrobox containers?" || rc=$?
        case "$rc" in
            0) run_stage Distrobox "${user_cmd[@]}" distrobox upgrade --all ;;
            130|143) exit "$rc" ;;
            *) skip Distrobox 'declined' ;;
        esac
    fi
else
    rc=$?
    case "$rc" in 130|143) exit "$rc" ;; esac
    results+=("Distrobox: failed to list containers (exit $rc)")
    ((++errors))
fi

section 'Results'
printf '%s\n' "${results[@]}"
section 'After update'
if have rpm-ostree && have jq; then
    if ! deployment_status; then
        log_error 'Unable to determine final deployment or reboot status'
        ((++errors))
    fi
else log_warn 'Deployment or reboot status unavailable'; fi
((errors == 0))
