#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: outpost [--status] [--help]

Opens the Outpost menu in a terminal.
Use --status to print status without opening the menu.

EOF
    exit 0 ;;
  ''|--status) ;;
  *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh

if [[ "${1:-}" != --status ]] && interactive && [[ -t 1 ]]; then
    while true; do
        menu_screen
        hdr "Outpost"
        choice=$(choose 'System status' 'Update' 'CAC tools' 'Fix CAC connection' 'Save diagnostic report' Rollback 'PDF signing setup' 'PDF signing help' 'Homebrew setup' 'Rebase' 'Quit') || exit 0
        case "$choice" in
            'System status') run_cmd outpost --status ;;
            Update) run_cmd update ;;
            'CAC tools') cac-help ;;
            'Fix CAC connection') run_cmd cac-recover ;;
            'Save diagnostic report') run_cmd cac-report ;;
            Rollback) run_cmd outpost-rollback ;;
            'PDF signing setup') run_cmd cac-pdf-setup ;;
            'PDF signing help') run_cmd cac-pdf-setup --help ;;
            'Homebrew setup') run_cmd brew-setup ;;
            Rebase) run_cmd rebase ;;
            Quit) exit 0 ;;
        esac
    done
fi

hdr "Outpost"

pretty="Outpost"
codename=""
if [[ -f /etc/os-release ]]; then
  # shellcheck source=/dev/null
  source /etc/os-release
  pretty="${PRETTY_NAME:-Outpost}"
  codename="${VERSION_CODENAME:-}"
fi

label="$pretty"
[[ -n "$codename" ]] && label="$label ($codename)"
line "$(ok)" "Image      $label"

line "$(ok)" "Kernel     $(uname -r)"

if have uptime; then
  up="$(uptime -p 2>/dev/null || true)"
  up="${up#up }"
  [[ -n "$up" ]] && line "$(ok)" "Uptime     $up"
fi

printf '\n'

cac_issues=()
if ! systemctl is-enabled pcscd.socket >/dev/null 2>&1; then
  cac_issues+=("pcscd")
fi

[[ -f /usr/lib64/pkcs11/opensc-pkcs11.so || -f /usr/lib64/opensc-pkcs11.so ]] ||
  cac_issues+=("OpenSC")

[[ -f /etc/pki/ca-trust/source/anchors/dod-trust-bundle.pem ]] || cac_issues+=("trust anchor")

if [[ ${#cac_issues[@]} -eq 0 ]]; then
  line "$(ok)" "CAC        Middleware installed (run cac-check for diagnostics)"
else
  line "$(warn)" "CAC        Issues: ${cac_issues[*]} (run cac-check)"
fi

if have rpm-ostree && have jq; then
    deployment_status || log_warn "Unable to read deployment status"
fi

user_context

if have flatpak; then
  sys_count="$(flatpak list --system --app --columns=application 2>/dev/null | wc -l)"
  user_count="$("${user_cmd[@]}" flatpak list --user --app --columns=application 2>/dev/null | wc -l)"
  line "$(ok)" "Flatpaks   ${sys_count} system, ${user_count} user"
fi

if have brew || [[ -x /var/home/linuxbrew/.linuxbrew/bin/brew ]]; then
  line "$(ok)" "Homebrew   Installed"
else
  dim "           Homebrew not installed (run brew-setup)"
fi

section 'Distrobox'
if ! have distrobox; then
    dim 'Distrobox is not installed.'
elif [[ "$target_uid" == 0 ]]; then
    dim 'Run as a desktop user to see their containers.'
elif distrobox_list; then
    printf '%s container(s)\n' "$distrobox_count"
    ((distrobox_count == 0)) || printf '%s\n' "$distrobox_output"
else
    log_warn 'Unable to list Distrobox containers.'
fi
