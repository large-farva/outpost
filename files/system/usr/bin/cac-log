#!/usr/bin/env bash
set -euo pipefail

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
Usage: cac-log [--help] [--since TIME]

Shows smartcard and CAC-related journal entries.

Options:
  --since TIME   Show entries since TIME (default: current boot)
  
  Accepts any valid journalctl --since argument:
    "2 hours ago"
    "today"
    "yesterday"
    "2026-01-01"
    "2026-01-01 12:00:00"

Example:
  cac-log --since "1 hour ago"

Sources: pcscd, firefox-module, opensc, p11-kit

EOF
    exit 0
    ;;
  ''|--since) ;;
  *) printf 'Unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

# shellcheck source=lib.sh
source /usr/lib/outpost/lib.sh

hdr "CAC logs"

journal_args=(--no-pager --output=short)

if [[ "${1:-}" == "--since" ]] && [[ -n "${2:-}" ]]; then
  journal_args+=("--since=$2")
  dim "Showing entries since $2"
else
  journal_args+=(-b)
  dim "Showing entries from current boot"
fi

printf '\n'

service_output=$(journalctl "${journal_args[@]}" --quiet -u pcscd.service -u pcscd.socket -t firefox-module) || {
    log_warn "Could not read all service logs"
}
library_output=$(journalctl "${journal_args[@]}" --quiet --grep='opensc|p11.kit|pkcs11|smart.card') || {
    log_warn "Could not read all CAC library logs"
}
output=$(printf '%s\n' "$service_output" "$library_output" | sort -u)


if [[ -n "$output" ]]; then
  printf '%s\n' "$output"
  printf '\n'
  count="$(wc -l <<< "$output")"
  line "$(ok)" "$count log entries"
else
  line "$(warn)" "No CAC-related log entries found"
fi
